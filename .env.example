# .env.example
AUTH_SECRET=replace-with-a-long-random-string
DATABASE_PATH=./data/vendor-quality.sqlite

# On Railway: set both of these to paths inside your persistent volume (e.g. /app/data/…)
# DATABASE_PATH=/app/data/vendor-quality.sqlite
# UPLOADS_ROOT=/app/data/uploads

# Required for Auth.js in production — must match your public URL
# NEXTAUTH_URL=https://quality.exceedoo.com
